# ============================================================
# UCSG — Environment Variables
# ============================================================
# Copy this file to `.env` for local development.
# On Vercel, add these in Project Settings → Environment Variables.
# ============================================================

# ---- Database (Prisma) ----
# LOCAL DEV: SQLite (default — a db/custom.db file is created automatically).
DATABASE_URL="file:./db/custom.db"

# VERCEL / PRODUCTION: SQLite won't work (Vercel's filesystem is read-only
# and serverless functions are ephemeral). Use a managed Postgres instead,
# e.g. Vercel Postgres, Neon, or Supabase. Then:
#   1. Change the provider in prisma/schema.prisma from "sqlite" to "postgresql".
#   2. Set DATABASE_URL to your Postgres connection string, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
#   3. Run `bun run db:push` locally to create the tables.
#
# NOTE: The contact form already persists "best-effort" — if the DB is
# unavailable, submissions still return success to the user; they just
# won't be stored. So the site works on Vercel even without a DB, but
# you won't receive the data. Set up Postgres to capture leads.

# ---- Z-AI Chatbot (LLM) ----
# LOCAL DEV: the z-ai-web-dev-sdk reads credentials from a .z-ai-config
# file (in the project root, home dir, or /etc/). No env vars needed.
#
# VERCEL / PRODUCTION: there's no config file on serverless, so provide
# the same values as environment variables. Get them from your z-ai
# dashboard / config file:
ZAI_BASE_URL="https://api.z.ai/api/v1"
ZAI_API_KEY="Z.ai"
ZAI_CHAT_ID=""
ZAI_USER_ID=""
ZAI_TOKEN=""
# (ZAI_CHAT_ID, ZAI_USER_ID, ZAI_TOKEN are optional but recommended
#  if your account requires them — copy from your local .z-ai-config.)
